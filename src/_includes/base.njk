<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — Flightline Review</title>
<meta name="description" content="{{ description or dek or 'Accurate, credible, and unbiased aviation and aerospace content.' }}">
<link rel="stylesheet" href="/style.css">
</head>
<body>

<header class="masthead">
  <div class="wrap">
    <a href="/" class="masthead-mark"><img src="/images/logo.jpeg" alt="Flightline Review" class="masthead-logo"></a>
    <nav class="masthead-nav">
      <a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a>
      <a href="/stories.html"{% if page.url == "/stories.html" or "/articles/" in page.url %} class="active"{% endif %}>Stories</a>
      <a href="/about.html"{% if page.url == "/about.html" %} class="active"{% endif %}>About</a>
      <a href="/contact.html"{% if page.url == "/contact.html" %} class="active"{% endif %}>Contact</a>
    </nav>
    <a href="/contact.html" class="masthead-cta">GET IN TOUCH</a>
  </div>
</header>

{{ content | safe }}

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div>
        <div class="footer-mark">FLIGHTLINE<span>·</span>REVIEW</div>
        <div class="footer-tagline">Accurate, credible, unbiased aviation and aerospace journalism.</div>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>SITE</h4>
          <a href="/">Home</a>
          <a href="/stories.html">Stories</a>
          <a href="/about.html">About</a>
          <a href="/contact.html">Contact</a>
        </div>
        <div class="footer-col">
          <h4>FOLLOW</h4>
          <a href="https://www.instagram.com/flightlinereview/">Instagram</a>
          <a href="https://www.facebook.com/profile.php?id=61588475706495">Facebook</a>
          <a href="mailto:Contact@flightlinereview.com">Email</a>
        </div>
        <div class="footer-col">
          <h4>LEGAL</h4>
          <a href="/terms.html">Terms & Conditions</a>
          <a href="/privacy.html">Privacy Policy</a>
          <a href="/cookies.html">Cookie Policy</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 FLIGHTLINE REVIEW. ALL RIGHTS RESERVED.</span>
      <span>BASED ON THE FLIGHTLINE</span>
    </div>
  </div>
</footer>

</body>
</html>
