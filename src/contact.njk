---
layout: base.njk
title: Contact
description: Have a tip, a story, or a correction? Get in touch with Flightline Review.
permalink: contact.html
---
<section class="page-hero">
  <div class="wrap">
    <div class="hero-eyebrow">GET IN TOUCH</div>
    <h1>Have a tip, a story, or a correction?</h1>
    <p>We take accuracy seriously — and we want to hear from the people who were there.</p>
  </div>
</section>

<div class="wrap">
  <div class="strip">
    <span class="strip-label">CONTACT</span>
    <span class="strip-fill"></span>
    <span>RESPONSE TIME · 2–3 DAYS</span>
  </div>
</div>

<section class="wrap" style="display:grid; grid-template-columns:1.4fr 1fr; gap:64px;">
  <div>
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you.html">
      <input type="hidden" name="form-name" value="contact">
      <p style="position:absolute; left:-9999px;">
        <label>Don't fill this out if you're human: <input name="bot-field"></label>
      </p>
      <div class="form-grid">
        <div class="form-field">
          <label for="name">NAME</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-field">
          <label for="email">EMAIL</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-field full">
          <label for="subject">SUBJECT</label>
          <input type="text" id="subject" name="subject" placeholder="Tip, story idea, correction...">
        </div>
        <div class="form-field full">
          <label for="message">MESSAGE</label>
          <textarea id="message" name="message" required></textarea>
        </div>
      </div>
      <button type="submit" class="submit-btn">Send Message</button>
    </form>
  </div>

  <div class="contact-info">
    <div class="ci-item">
      <h4>EMAIL</h4>
      <a href="mailto:Contact@flightlinereview.com">Contact@flightlinereview.com</a>
    </div>
    <div class="ci-item">
      <h4>FOLLOW</h4>
      <p><a href="https://www.instagram.com/flightlinereview/">Instagram</a></p>
      <p><a href="https://www.facebook.com/profile.php?id=61588475706495">Facebook</a></p>
    </div>
    <div class="ci-item">
      <h4>FOR TIPS</h4>
      <p>Include as much detail as you can — dates, locations, and anything that helps us verify before we publish.</p>
    </div>
  </div>
</section>
